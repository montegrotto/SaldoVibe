SALDOVIBE_PUBLIC_URL=http://localhost:8000

# Which montegrotto/saldovibe image tag docker-compose.yml runs (default: latest).
# SALDOVIBE_VERSION=1.0.0

# Docker Compose auto-loads this root .env file both for ${...} interpolation inside the
# compose YAML and (via env_file) as container environment. Host port for the nginx service:
NGINX_HTTP_PORT=80

# manage.py also auto-loads this file via python-dotenv, so it's what a bare
# `python manage.py runserver` (outside Docker) picks up. Uncomment for local dev to get
# Django debug mode and the green "DEV" sidebar styling. docker-compose.yml hardcodes
# DJANGO_DEBUG=0 regardless, so this has no effect on the compose stack.
# DJANGO_DEBUG=1

# SALDOVIBE_PUBLIC_URL above narrows ALLOWED_HOSTS to just "localhost". If you also want
# to browse via 127.0.0.1 for a bare `manage.py runserver`, uncomment this to pin both:
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# The ReInvGrabber attachment-extraction integration (see attachments/extraction_client.py)
# runs in-process and needs no separate service. It requires the Tesseract OCR binary (with
# Swedish language data) on PATH - already installed in the Dockerfile; for a bare
# `manage.py runserver` install it yourself (`brew install tesseract tesseract-lang` on macOS).
# Set to 0 to disable extraction entirely (attachment upload behaves exactly as before):
# REINVGRABBER_ENABLED=0

# --- Produktion (docker-compose.yml-stacken) -------------------------------------------
# Avkommentera och sätt riktiga värden vid driftsättning. Utan DATABASE_* körs appen mot
# sqlite — Postgres-stacken kräver allihop.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=change-me
# Fältkryptering (personnummer). Sätt explicit i produktion — annars härleds nyckeln
# ur DJANGO_SECRET_KEY och ett nyckelbyte gör krypterade fält oläsbara.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SALDOVIBE_FIELD_ENCRYPTION_KEY=
# SALDOVIBE_DATA_DIR=/data
# SALDOVIBE_STATIC_ROOT=/app/staticfiles
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=saldovibe
# DATABASE_USER=saldovibe
# DATABASE_PASSWORD=change-me
# DATABASE_HOST=db
# DATABASE_PORT=5432
# POSTGRES_DB=saldovibe
# POSTGRES_USER=saldovibe
# POSTGRES_PASSWORD=change-me

# Systemkonto för utgående e-post (daglig notisdigest, se docs/ops/environment-variables.md).
# Tomt EMAIL_HOST = konsol-backend, inget skickas. Kundmail (fakturor/påminnelser) skickas via
# företagets eget konto i företagsinställningarna, inte via dessa variabler.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=notiser@example.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=notiser@example.com
