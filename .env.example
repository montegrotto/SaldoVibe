SALDOVIBE_PUBLIC_URL=http://localhost:8000

# Which montegrotto/saldovibe image tag the compose files run (default: latest).
# SALDOVIBE_VERSION=1.0.0

# Docker Compose auto-loads this root .env file for ${...} interpolation inside compose
# YAML (host port mappings etc.) for every compose file in this project, regardless of
# which one is passed via -f. NGINX_HTTP_PORT is only referenced by docker-compose.prod.yml's
# nginx service (host port -> container port 80); harmless to leave set for the other stacks.
NGINX_HTTP_PORT=80

# manage.py also auto-loads this file via python-dotenv, so it's what a bare
# `python manage.py runserver` (outside Docker) picks up. Uncomment for local dev to get
# Django debug mode and the green "DEV" sidebar styling. docker-compose.yml's standalone
# profile hardcodes DJANGO_DEBUG=0 regardless, so this has no effect on that stack.
# DJANGO_DEBUG=1

# SALDOVIBE_PUBLIC_URL above narrows ALLOWED_HOSTS to just "localhost". If you also want
# to browse via 127.0.0.1 for a bare `manage.py runserver`, uncomment this to pin both:
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# The ReInvGrabber attachment-extraction integration (see attachments/extraction_client.py)
# runs in-process and needs no separate service. It requires the Tesseract OCR binary (with
# Swedish language data) on PATH - already installed in both Dockerfiles; for a bare
# `manage.py runserver` install it yourself (`brew install tesseract tesseract-lang` on macOS).
# Set to 0 to disable extraction entirely (attachment upload behaves exactly as before):
# REINVGRABBER_ENABLED=0

# Systemkonto för utgående e-post (daglig notisdigest, se docs/ops/environment-variables.md).
# Tomt EMAIL_HOST = konsol-backend, inget skickas. Kundmail (fakturor/påminnelser) skickas via
# företagets eget konto i företagsinställningarna, inte via dessa variabler.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=notiser@example.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=notiser@example.com
